rules_version = '2';

// Regras do Firestore. Testes em functions/test/rules.test.ts (npm run test:emulators).
// Participantes e papéis só mudam por Cloud Functions (docs/plan.md, seção 3);
// despesas, acertos e comprovantes também (Fases 5 e 6).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function inSplit(splitId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/splits/$(splitId)).data.uids;
    }

    match /splits/{splitId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;

      // Despesas só mudam por Functions (validadas com o @qpq/calc; decisões 7 e 8).
      match /expenses/{expenseId} {
        allow read: if inSplit(splitId);
        allow write: if false;

        match /history/{historyId} {
          allow read: if inSplit(splitId);
          allow write: if false;
        }
      }

      match /payments/{paymentId} {
        allow read: if inSplit(splitId);
        allow write: if false;
      }
    }

    // Perfil e preferências (spec 08). `recovery` só as Functions escrevem.
    function validPrefs(p) {
      return p is map
        && p.keys().hasOnly(['inapp', 'email', 'selfName', 'askProof', 'theme', 'lang'])
        && (!('inapp' in p) || p.inapp is bool)
        && (!('email' in p) || p.email is bool)
        && (!('selfName' in p) || p.selfName is bool)
        && (!('askProof' in p) || p.askProof is bool)
        && (!('theme' in p) || p.theme in ['light', 'dark'])
        && (!('lang' in p) || p.lang in ['pt-BR', 'en']);
    }

    // Foto de perfil: só um arquivo na pasta da própria pessoa no Storage (users/{uid}/…).
    function validPhoto(uid, p) {
      return p == null || (p is string && p.matches('users/' + uid + '/[A-Za-z0-9_-][A-Za-z0-9._-]{0,79}'));
    }

    function validProfile(uid, d) {
      return (!('displayName' in d) || (d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40))
        && (!('prefs' in d) || validPrefs(d.prefs))
        && (!('photoPath' in d) || validPhoto(uid, d.photoPath));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'prefs', 'photoPath'])
        && validProfile(uid, request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'prefs', 'photoPath'])
        && validProfile(uid, request.resource.data);
      allow delete: if false;
    }

    // inviteCodes, recoveryTokens, mergeTokens, proofs (prazo dos comprovantes) e qualquer
    // outra coleção: só o Admin SDK (Functions).
  }
}
