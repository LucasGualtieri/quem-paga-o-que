{
  "name": "@qpq/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --log-level=warning",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "vitest run"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@qpq/calc": "*",
    "@qpq/shared": "*",
    "esbuild": "0.28.2",
    "firebase": "13.1.0"
  }
}
